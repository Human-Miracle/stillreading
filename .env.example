# Neon Postgres connection string (Vercel → Storage → Neon sets this automatically).
# Leave unset for local development: Still Reading falls back to an embedded PGlite database in ./.data
DATABASE_URL=

# Reply notifications (Web Push). Generate a pair with: npx web-push generate-vapid-keys
# Leave unset to turn notifications off (the setting then hides itself).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or an https URL (defaults to the repo URL).
VAPID_SUBJECT=

# Only needed if/when avatar or artwork uploads are added (not used by the MVP).
# BLOB_READ_WRITE_TOKEN=
